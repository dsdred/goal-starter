<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="GoAl"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="GoAl Team"
           UpgradeCode="a1b2c3d4-e5f6-7890-abcd-ef1234567890">
    <Package Installer="yes"
             Platform="x64"
             Compressed="yes"
             Description="GoAl - Local AI Runtime Manager"
             InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" />

    <UI>
      <UIRef Id="WixUI_FeatureTree" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="3">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3">1</Publish>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3">
        <![CDATA[NOT Installed]]>
      </Publish>
    </UI>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <!-- Feature definition -->
    <Feature Id="ProductFeature" Title="GoAl" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ServiceScripts" />
      <ComponentGroupRef Id="ConfigFiles" />
      <ComponentGroupRef Id="Documentation" />
    </Feature>

    <!-- Registry entries for config path -->
    <Property Id="GOAL_INSTALL_PATH" Value="[INSTALLDIR]" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="GoAl">
          <Directory Id="ServiceScriptsDir" Name="service" />
          <Directory Id="ConfigDir" Name="etc" />
          <Directory Id="DocsDir" Name="docs" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenu64Folder">
        <Directory Id="StartMenuFolder" Name="GoAl" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <!-- Binary references (will be replaced by light with actual files) -->
    <ComponentGroup Id="ProductComponents">
      <Component Id="MainBinary" Guid="b2c3d4e5-f6a7-8901-bcde-f12345678901" Directory="INSTALLDIR">
        <File Source="$(var.BinaryPath)" KeyName="goal.exe" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\GoAl" ForceCreateRoot="yes">
          <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLDIR]" Action="write" />
          <RegistryValue Name="Version" Type="string" Value="$(var.Version)" Action="write" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ServiceScripts">
      <Component Id="InstallServiceScript" Guid="c3d4e5f6-a7b8-9012-cdef-123456789012" Directory="ServiceScriptsDir">
        <File Source="$(var.InstallScriptPath)" KeyName="install-service.ps1" />
      </Component>
      <Component Id="UninstallServiceScript" Guid="d4e5f6a7-b8c9-0123-def0-234567890123" Directory="ServiceScriptsDir">
        <File Source="$(var.UninstallScriptPath)" KeyName="uninstall-service.ps1" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConfigFiles">
      <Component Id="ExampleConfig" Guid="e5f6a7b8-c9d0-1234-ef01-345678901234" Directory="ConfigDir">
        <File Source="$(var.ExampleConfigPath)" KeyName="goal.example.json" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Documentation">
      <Component Id="ReadmeMd" Guid="f6a7b8c9-d0e1-2345-f012-456789012345" Directory="DocsDir">
        <File Source="$(var.ReadmePath)" KeyName="README.md" />
      </Component>
      <Component Id="ReadmeRuMd" Guid="a7b8c9d0-e1f2-3456-0123-567890123456" Directory="DocsDir">
        <File Source="$(var.ReadmeRuPath)" KeyName="README_RU.md" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu Shortcuts -->
    <Component Id="StartMenuShortcut" Guid="12345678-90ab-cdef-1234-567890abcdef" Directory="StartMenuFolder">
      <Shortcut Id="GoAlShortcut"
                Name="GoAl"
                Target="[INSTALLDIR]goal.exe"
                Description="GoAl - Local AI Runtime Manager" />
      <RemoveFolder Id="RemoveStartMenu" Directory="StartMenuFolder" On="uninstall" />
      <RegistryKey Root="HKCU" Key="Software\GoAl" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="StartMenuShortcut" Type="integer" Value="1" Action="write" />
      </RegistryKey>
    </Component>

    <!-- Desktop Shortcut (optional, not created by default) -->
  </Fragment>
</Wix>